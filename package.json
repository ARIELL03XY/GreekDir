{
  "name": "greekdir",
  "version": "1.0.0-beta.2",
  "description": "Desktop disk usage analyzer with a modern Claude-inspired interface",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run patch:builder && tsc && vite build && electron-builder --publish never",
    "build:win": "npm run patch:builder && tsc && vite build && electron-builder --win nsis --x64 --publish never",
    "build:mac": "npm run patch:builder && tsc && vite build && electron-builder --mac --publish never",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "lint": "eslint src electron --ext .ts,.tsx",
    "patch:builder": "node scripts/patch-electron-builder.cjs",
    "icons": "electron scripts/build-icons.cjs",
    "changelog": "node scripts/changelog.mjs site",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "disk-analyzer",
    "windirstat",
    "electron",
    "treemap"
  ],
  "author": {
    "name": "ARIELL03XY",
    "url": "https://github.com/ARIELL03XY"
  },
  "license": "MIT",
  "build": {
    "appId": "com.chvnetworktechnologies.greekdir",
    "productName": "GreekDir",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "script": "build/installer.nsi",
      "include": "build/greekdir-installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "GreekDir reads file sizes in your Desktop folder to show what is using disk space. Nothing leaves your Mac.",
        "NSDocumentsFolderUsageDescription": "GreekDir reads file sizes in your Documents folder to show what is using disk space. Nothing leaves your Mac.",
        "NSDownloadsFolderUsageDescription": "GreekDir reads file sizes in your Downloads folder to show what is using disk space. Nothing leaves your Mac.",
        "NSRemovableVolumesUsageDescription": "GreekDir reads file sizes on removable drives you choose to scan. Nothing leaves your Mac.",
        "NSNetworkVolumesUsageDescription": "GreekDir reads file sizes on network drives you choose to scan. Nothing leaves your Mac.",
        "NSAppleEventsUsageDescription": "GreekDir asks Finder to empty the Trash when you choose Clean Up → Empty Trash."
      }
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "copyright": "Copyright © 2026 CHV Network Technologies",
    "extraMetadata": {
      "author": {
        "name": "CHV Network Technologies"
      }
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "d3": "^7.9.0",
    "electron": "^45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^8.57.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
